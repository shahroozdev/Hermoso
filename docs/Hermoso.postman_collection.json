{
  "info": {
    "name": "Hermoso API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "salonId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@hermoso.app\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "Analytics - Admin Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/analytics/admin/dashboard"
      }
    },
    {
      "name": "Salons - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/salons"
      }
    },
    {
      "name": "Services - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/services?salonId={{salonId}}"
      }
    },
    {
      "name": "Staff - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/staff"
      }
    },
    {
      "name": "Bookings - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/bookings"
      }
    },
    {
      "name": "Customers - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/customers"
      }
    },
    {
      "name": "Reviews - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/reviews"
      }
    },
    {
      "name": "Payouts - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/payouts"
      }
    },
    {
      "name": "Notifications - Send Announcement",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/notifications/announcement",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Maintenance\",\n  \"message\": \"Platform maintenance window at 11:00 PM UTC\",\n  \"targetRole\": \"salon_owner\"\n}"
        }
      }
    }
  ]
}
