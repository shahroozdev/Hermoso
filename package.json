{
  "name": "hermoso",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint",
    "lint:client": "pnpm --filter hermoso-client lint",
    "lint:server": "pnpm --filter hermoso-server lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "typescript-eslint": "^8.62.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  }
}
